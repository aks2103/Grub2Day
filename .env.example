# ==============================================================================
# Grub2Day — Environment Configuration Template
# ==============================================================================

VITE_APP_NAME="Grub2Day"
VITE_APP_TAGLINE="Ghar Ka Khana, Zero Bahana! 🍲"

# Database Provider ('local' for local NoSQL, 'firestore' for Cloud Firestore)
VITE_DB_TYPE="local"

# Profile & Target Settings
VITE_HUSBAND_NAME="Alok"
VITE_HUSBAND_PROTEIN_TARGET=120
VITE_HUSBAND_CALORIE_TARGET=1800
VITE_COOLDOWN_DAYS=6

# Firebase (Populate when switching VITE_DB_TYPE to 'firestore')
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
